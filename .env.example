TIKTOK_USERNAME=tu_usuario
TIKTOK_ENABLED=1
HOST=127.0.0.1
PORT=3000
DEMO_MODE=0
MAX_AVATARS=40
# Clave requerida por Euler Stream para firmar la conexión de TikTok.
# Preferir el campo privado del estudio (guardado cifrado en Windows).
# Alternativa para configuración externa: SIGN_API_KEY o EULER_SIGN_API_KEY.
# EULER_SIGN_API_KEY=

# Ingreso principal: member (al entrar al LIVE) o chat (compatibilidad).
JOIN_TRIGGER=member

# Salida gradual tras inactividad (segundos). 0 la desactiva.
IDLE_SECONDS=120
